SECRET_KEY=change-me
DATABASE_URL=sqlite:///urembo.db

GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret

# Optional locally. In Railway, set this only if you want to pin the callback URL.
# It must exactly match a Google OAuth authorized redirect URI.
GMAIL_REDIRECT_URI=https://your-railway-domain.up.railway.app/email/oauth2callback
